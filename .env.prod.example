# ===== 对外地址 =====
# 有域名：SITE_ADDRESS=scenemind.example.com（Caddy 自动申请 HTTPS 证书）
# 只有公网 IP、想要 HTTPS：SITE_ADDRESS=1.2.3.4.sslip.io（sslip.io 自动解析到该 IP）
# 只有 IP、暂时不上 HTTPS：SITE_ADDRESS=http://1.2.3.4
SITE_ADDRESS=scenemind.example.com

# ===== 站点访问密码（Caddy basic auth）=====
BASIC_AUTH_USER=demo
# 生成方式（本机或服务器均可）：
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '你的密码'
# 注意：bcrypt 哈希里含 $，在 .env 中必须用单引号包起来，否则会被 shell 当成变量展开。
BASIC_AUTH_HASH='change-me-bcrypt-hash'

# ===== 数据库 =====
MYSQL_ROOT_PASSWORD=change-me
DB_USERNAME=dovideo
MYSQL_APP_USER=dovideo
DB_PASSWORD=change-me
FLYWAY_BASELINE_ON_MIGRATE=true

# ===== Redis =====
REDIS_PASSWORD=change-me

# ===== MinIO =====
MINIO_ACCESS_KEY=dovideo
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=media

# ===== Qdrant =====
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=video_chunks

# ===== 模型服务（必填真实 Key）=====
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR

# ===== 成本护栏（公网实例务必填真实单价）=====
# 单价单位：元 / 百万 token。留 0 表示不启用成本估算。
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
# 单任务预估成本上限（元）。0 = 关闭。建议 1~5。
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000

# ===== 账号与跨域 =====
# 建好自己的账号后改为 false，关闭公开注册（公网实例强烈建议）
AUTH_REGISTRATION_ENABLED=true
# 与 SITE_ADDRESS 的完整 URL 一致；同源部署时浏览器不会触发 CORS
CORS_ALLOWED_ORIGINS=https://scenemind.example.com

# ===== 其他 =====
SERVER_PORT=9090
