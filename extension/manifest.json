{
  "manifest_version": 3,
  "name": "SceneMind",
  "version": "0.1.0",
  "description": "把当前页视频链接一键提交给 SceneMind Video Agent 分析",
  "permissions": ["tabs", "sidePanel", "storage"],
  "host_permissions": [
    "http://127.0.0.1:9090/*",
    "https://b23.tv/*",
    "https://www.bilibili.com/*",
    "https://bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SceneMind 视频分析"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
